{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VTerminal default window capabilities. start-dragging is required by the custom title bar (Header.tsx data-tauri-drag-region) — without it the window cannot be moved.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "log:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
